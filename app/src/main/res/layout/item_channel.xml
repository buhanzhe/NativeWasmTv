<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:background="@drawable/channel_item_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingRight="8dp">

    <TextView
        android:id="@+id/channel_number"
        android:layout_width="34dp"
        android:layout_height="27dp"
        android:background="@drawable/channel_number_background"
        android:gravity="center"
        android:textColor="@color/channel_item_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/channel_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/channel_item_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/channel_group_count"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="5dp"
        android:background="@drawable/channel_group_count_background"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="28dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/channel_item_favorite"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginLeft="4dp"
        android:background="@drawable/favorite_button_background"
        android:clickable="true"
        android:contentDescription="收藏"
        android:focusable="false"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/collection" />
</LinearLayout>
