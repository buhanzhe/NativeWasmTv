<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="@drawable/channel_group_item_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingRight="8dp">

    <FrameLayout
        android:layout_width="27dp"
        android:layout_height="27dp">

        <TextView
            android:id="@+id/channel_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/channel_group_number_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/channel_item_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/channel_group_favorite_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/channel_group_number_background"
            android:contentDescription="我的收藏"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/collection_fill"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/channel_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/channel_item_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/channel_group_count"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="5dp"
        android:background="@drawable/channel_group_count_background"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="28dp"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
