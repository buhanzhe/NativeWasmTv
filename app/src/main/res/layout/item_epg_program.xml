<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/epg_program_background"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="7dp"
    android:paddingRight="12dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/epg_program_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textColor="@color/epg_program_time_text"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/epg_program_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/epg_program_title_text"
        android:textStyle="bold"
        android:textSize="14sp" />
</LinearLayout>
