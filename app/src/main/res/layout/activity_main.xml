<?xml version="1.0" encoding="utf-8"?>
<xiao.bu.tv.PlayerRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <xiao.bu.tv.DirectVideoView
        android:id="@+id/video_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <View
        android:id="@+id/startup_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <xiao.bu.tv.AudioArtworkView
        android:id="@+id/audio_artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <xiao.bu.tv.WebSourceView
        android:id="@+id/web_source"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/subtitle_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginLeft="44dp"
        android:layout_marginRight="44dp"
        android:layout_marginBottom="52dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="4"
        android:shadowColor="#FF000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="RtlHardcoded" />


    <TextView
        android:id="@+id/video_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:visibility="gone"
        tools:ignore="HardcodedText,RtlHardcoded" />

    <TextView
        android:id="@+id/video_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp"
        android:fontFamily="monospace"
        android:gravity="right|center_vertical"
        android:includeFontPadding="false"
        android:shadowColor="#E6000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:textColor="#FFFFFFFF"
        android:text="2026年08月26日 12:35:28 星期三"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="HardcodedText,RtlHardcoded" />

    <TextView
        android:id="@+id/video_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:gravity="left|center_vertical"
        android:includeFontPadding="false"
        android:shadowColor="#E6000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="2026年08月25日"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="HardcodedText,RtlHardcoded" />

    <TextView
        android:id="@+id/debug_info_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="8dp"
        android:layout_marginRight="12dp"
        android:fontFamily="monospace"
        android:gravity="left"
        android:includeFontPadding="true"
        android:maxLines="4"
        android:shadowColor="#E6000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:text="--\n--  -- Fps  --  --  --  --  CPU --"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        tools:ignore="HardcodedText,RtlHardcoded" />

    <TextView
        android:id="@+id/network_speed_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="monospace"
        android:gravity="right"
        android:includeFontPadding="false"
        android:shadowColor="#E6000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:text="--"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="HardcodedText,RtlHardcoded" />

    <TextView
        android:id="@+id/numeric_channel_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="36dp"
        android:layout_marginRight="40dp"
        android:background="@drawable/numeric_channel_background"
        android:gravity="center"
        android:minWidth="104dp"
        android:paddingLeft="22dp"
        android:paddingTop="10dp"
        android:paddingRight="22dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_primary"
        android:textSize="52sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="RtlHardcoded" />

    <LinearLayout
        android:id="@+id/channel_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="108dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/player_info_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="9dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone">




        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/channel_card_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:textColor="#74B9FF"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/channel_name"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/video_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="--×-- · --fps"
                    android:textColor="#78FFFFFF"
                    android:textSize="10sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="3dp"
                android:background="#40FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B8FFFFFF"
                    android:textSize="12sp" />
                <xiao.bu.tv.LoadingSpinnerView
                    android:id="@+id/channel_progress"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="8dp"
                    android:visibility="invisible" />
            </LinearLayout>

            <TextView
                android:id="@+id/channel_epg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:minLines="2"
                android:lineSpacingExtra="3dp"
                android:textColor="#E0FFFFFF"
                android:textSize="12sp"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/channel_list_panel"
        android:layout_width="1000dp"
        android:layout_height="match_parent"
        android:background="@drawable/channel_panel_background"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="0dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ListView
                android:id="@+id/channel_group_list"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:choiceMode="singleChoice"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="4dp"
                android:focusableInTouchMode="true"
                android:listSelector="@drawable/channel_group_item_background"
                android:paddingTop="0dp"
                android:paddingBottom="0dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:background="@color/divider" />

            <ListView
                android:id="@+id/channel_list"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:choiceMode="singleChoice"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="4dp"
                android:focusableInTouchMode="true"
                android:listSelector="@drawable/channel_item_background"
                android:paddingTop="0dp"
                android:paddingBottom="0dp" />

            <TextView
                android:id="@+id/epg_toggle"
                android:layout_width="28dp"
                android:layout_height="120dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:background="@drawable/channel_item_background"
                android:clickable="true"
                android:focusable="false"
                android:contentDescription="展开节目单"
                android:text="节\n目\n单\n›"
                android:textSize="13sp"
                android:textColor="#DFFFFFFF" />

            <View
                android:id="@+id/channel_epg_divider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:background="@color/divider"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/epg_column"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingRight="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/epg_favorite"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:paddingLeft="8dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/favorite_button_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="☆ 收藏"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/epg_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingLeft="8dp"
                    android:paddingTop="8dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="8dp"
                    android:text="正在加载节目单"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:ignore="HardcodedText" />

                <ListView
                    android:id="@+id/epg_list"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:choiceMode="singleChoice"
                    android:clipToPadding="false"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="4dp"
                    android:focusableInTouchMode="true"
                    android:listSelector="@drawable/channel_item_background"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/management_panel"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/first_launch_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="22dp"
        android:paddingRight="28dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/management_scan_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <xiao.bu.tv.QrCodeView
            android:id="@+id/management_qr"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/management_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/management_same_lan"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="返回键关闭"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/back_navigation_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/first_launch_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="22dp"
        android:paddingTop="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/back_prompt_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="@string/back_navigation_prompt"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/back_prompt_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:minWidth="92dp"
            android:text="@string/confirm"
            android:textSize="15sp" />
    </LinearLayout>

    <xiao.bu.tv.FlyMouseCursorView
        android:id="@+id/fly_mouse_cursor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</xiao.bu.tv.PlayerRootLayout>
