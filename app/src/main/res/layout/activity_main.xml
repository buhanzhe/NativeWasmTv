<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <xiao.bu.tv.DirectVideoView
        android:id="@+id/video_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <xiao.bu.tv.WebSourceView
        android:id="@+id/web_source"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/channel_switch_blackout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/channel_swipe_snapshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:scaleType="fitCenter"
        android:visibility="gone"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/video_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp"
        android:fontFamily="monospace"
        android:gravity="right|center_vertical"
        android:includeFontPadding="false"
        android:shadowColor="#E6000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:textColor="#FFFFFFFF"
        android:text="2026年08月26日 12:35:28 星期三"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="HardcodedText,RtlHardcoded" />

    <TextView
        android:id="@+id/video_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:gravity="left|center_vertical"
        android:includeFontPadding="false"
        android:shadowColor="#E6000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="2026年08月25日"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="HardcodedText,RtlHardcoded" />

    <TextView
        android:id="@+id/debug_info_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp"
        android:fontFamily="monospace"
        android:gravity="right"
        android:includeFontPadding="false"
        android:maxLines="3"
        android:shadowColor="#E6000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:text="视频 --  --fps  --  --\n音频 --  --\nCPU（本应用） --"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        tools:ignore="HardcodedText,RtlHardcoded" />

    <TextView
        android:id="@+id/network_speed_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="monospace"
        android:gravity="right"
        android:includeFontPadding="false"
        android:shadowColor="#E6000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:text="--"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="HardcodedText,RtlHardcoded" />

    <TextView
        android:id="@+id/numeric_channel_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="36dp"
        android:layout_marginRight="40dp"
        android:background="@drawable/numeric_channel_background"
        android:gravity="center"
        android:minWidth="104dp"
        android:paddingLeft="22dp"
        android:paddingTop="10dp"
        android:paddingRight="22dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_primary"
        android:textSize="52sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="RtlHardcoded" />

    <LinearLayout
        android:id="@+id/channel_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/player_info_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="11dp"
        android:paddingRight="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/channel_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="10dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/channel_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B8FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/channel_source_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="#9FFFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/channel_epg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E0FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="38dp"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:background="#24FFFFFF" />

        <TextView
            android:id="@+id/video_info"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="right|center_vertical"
            android:maxLines="2"
            android:text="-- × -- · -- fps · --&#10;IJK 硬解"
            android:textColor="#C8FFFFFF"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            tools:ignore="HardcodedText,RtlHardcoded" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/channel_list_panel"
        android:layout_width="1000dp"
        android:layout_height="match_parent"
        android:background="@drawable/channel_panel_background"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ListView
                android:id="@+id/channel_group_list"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:choiceMode="singleChoice"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="5dp"
                android:focusableInTouchMode="true"
                android:listSelector="@drawable/channel_group_item_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:background="@color/divider" />

            <ListView
                android:id="@+id/channel_list"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:choiceMode="singleChoice"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="3dp"
                android:focusableInTouchMode="true"
                android:listSelector="@drawable/channel_item_background"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/epg_column"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/epg_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingLeft="8dp"
                    android:paddingTop="6dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="8dp"
                    android:text="正在加载节目单"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:ignore="HardcodedText" />

                <ListView
                    android:id="@+id/epg_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:choiceMode="singleChoice"
                    android:clipToPadding="false"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="4dp"
                    android:focusableInTouchMode="true"
                    android:listSelector="@drawable/channel_item_background"
                    android:paddingTop="2dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingTop="9dp"
            android:text="节目组  →  频道  →  收藏  →  当前频道节目单"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/management_panel"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/first_launch_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="22dp"
        android:paddingRight="28dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/management_scan_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <xiao.bu.tv.QrCodeView
            android:id="@+id/management_qr"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/management_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/management_same_lan"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="返回键关闭"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/back_navigation_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/first_launch_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="22dp"
        android:paddingTop="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/back_prompt_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="@string/back_navigation_prompt"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/back_prompt_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:minWidth="92dp"
            android:text="@string/confirm"
            android:textSize="15sp" />
    </LinearLayout>

    <xiao.bu.tv.FlyMouseCursorView
        android:id="@+id/fly_mouse_cursor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
