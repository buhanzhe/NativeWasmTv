<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="4dp" android:right="2dp">
        <shape>
            <corners android:radius="22dp" />
            <solid android:color="#52000000" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape>
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#EE25262B"
                android:endColor="#DC121318" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
        </shape>
    </item>
</layer-list>
