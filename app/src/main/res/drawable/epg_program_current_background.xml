<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="#F03A82F7" />
            <stroke android:width="2dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="8dp" />
            <gradient android:angle="0" android:startColor="#D93478D0" android:endColor="#D24D91E3" />
            <stroke android:width="1dp" android:color="#80A9D4FF" />
        </shape>
    </item>
</selector>
